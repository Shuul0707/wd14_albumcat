# virtualenv / python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# scratch dirs (sandbox TEMP, pip cache)
.tmp/
.pipcache/

# downloaded model weights (~356 MB) -- re-fetch with tools/download_model.py
models/

# user photos used for testing -- never commit these
samples/

# runtime state (journal, caches) -- added later. Anchored to the repo root so
# it does not swallow source data such as src/albumcat/data/tag_zh.json.
/data/

# build outputs: the Aves fork's APK is a build artifact, not a source --
# publish it as a GitHub Release asset instead. dist/ also holds the course
# slide deck (and its PDF), whose docProps carry a real author name: scrub
# those before publishing anything from there.
build/
dist/
*.apk
*.aab

# signing material, if you ever add it
*.keystore
*.jks

# third-party reference clone only: it carries its own .git and is not needed
# at runtime (src/albumcat/tagger.py talks to onnxruntime directly).
# Re-clone it per README「安装」instead of committing it here.
third_party/

# editor / OS noise
.idea/
*.iml
.vscode/
*.log
Thumbs.db
Desktop.ini
